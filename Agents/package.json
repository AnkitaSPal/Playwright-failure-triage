{
  "name": "playwright-failure-triage",
  "version": "1.0.0",
  "description": "Installable Playwright failure triage: classify, live-verify, file Jira, HITL UI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "playwright-triage": "./cli.cjs"
  },
  "files": [
    "dist",
    "ui",
    "cli.cjs",
    "triage.config.example.json",
    ".env.example",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "triage": "node ./cli.cjs",
    "triage:ui": "node ./cli.cjs ui"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.28",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "playwright",
    "triage",
    "jira",
    "test-failures",
    "cursor"
  ],
  "license": "ISC"
}
