{
  "name": "playwright-failure-triage",
  "version": "1.0.0",
  "description": "Installable Playwright failure triage: classify, live-verify, file Jira, HITL UI",
  "main": "Agents/dist/index.js",
  "types": "Agents/dist/index.d.ts",
  "bin": {
    "playwright-triage": "./Agents/cli.cjs"
  },
  "files": [
    "Agents/dist",
    "Agents/ui",
    "Agents/cli.cjs",
    "Agents/triage.config.example.json",
    ".env.example",
    "README.md",
    "WORKFLOW.md"
  ],
  "scripts": {
    "build": "tsc -p Agents/tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "triage": "node ./Agents/cli.cjs",
    "triage:ui": "node ./Agents/cli.cjs ui"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.28",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "playwright",
    "triage",
    "jira",
    "test-failures",
    "cursor"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnkitaSPal/Playwright-failure-triage.git"
  }
}
